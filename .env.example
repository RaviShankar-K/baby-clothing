# Copy to .env.local (gitignored) and fill in to enable features.

# Google Gemini API key — enables photorealistic AI try-on renders
# (full-body photo of the uploaded baby wearing the selected outfit).
# Get one at https://aistudio.google.com/apikey
# Without it, the try-on falls back to the fully local in-browser composite.
GEMINI_API_KEY=
